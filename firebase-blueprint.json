{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student user profile with campus affiliation, interests, and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The authenticated user UID"
        },
        "name": {
          "type": "string",
          "description": "Student full or preferred name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Student email address",
          "maxLength": 150
        },
        "college": {
          "type": "string",
          "description": "Student university or college campus",
          "maxLength": 120
        },
        "year": {
          "type": "string",
          "description": "Academic year of study",
          "maxLength": 50
        },
        "bio": {
          "type": "string",
          "description": "Short student bio and campus vibe description",
          "maxLength": 500
        },
        "avatarColor": {
          "type": "string",
          "description": "Hex color code for the user avatar",
          "maxLength": 20
        },
        "avatarInitials": {
          "type": "string",
          "description": "User initials displayed on the avatar",
          "maxLength": 5
        },
        "isOnboarded": {
          "type": "boolean",
          "description": "Whether the user completed onboarding"
        },
        "freeUntil": {
          "type": "number",
          "description": "Timestamp epoch until when the student is free"
        },
        "freeStatusNote": {
          "type": "string",
          "description": "Short note of what activity the student is free for",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format"
        }
      },
      "required": ["userId", "name", "college", "isOnboarded"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Campus activity or sports squad created by students",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "categoryGroup": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 1000 },
        "venue": { "type": "string", "maxLength": 150 },
        "dateTime": { "type": "string", "maxLength": 50 },
        "durationMinutes": { "type": "number" },
        "maxParticipants": { "type": "number" },
        "skillLevel": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "description": "Creator student Firebase UID" },
        "hostName": { "type": "string", "maxLength": 100 },
        "hostAvatarColor": { "type": "string", "maxLength": 20 },
        "hostAvatarInitials": { "type": "string", "maxLength": 5 },
        "participantIds": { "type": "array", "description": "List of participant student UIDs" },
        "status": { "type": "string", "enum": ["active", "open", "full", "completed", "cancelled"] },
        "isOneToOne": { "type": "boolean", "description": "Whether this is a 1-to-1 Who's Free match" },
        "matchRequestId": { "type": "string", "description": "Associated MatchRequest document ID" },
        "requesterUid": { "type": "string", "description": "Requester student UID for 1-to-1 match" },
        "requesterName": { "type": "string", "maxLength": 100 },
        "endedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "cancelledAt": { "type": "string" },
        "endedByUid": { "type": "string" },
        "originalBroadcastExpiresAt": { "type": "number" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["title", "category", "venue", "maxParticipants", "createdBy", "hostName", "participantIds", "status"]
    },
    "MatchRequest": {
      "title": "MatchRequest",
      "description": "1-to-1 match request between students in Who's Free",
      "type": "object",
      "properties": {
        "hostUid": { "type": "string", "description": "Target host student UID" },
        "requesterUid": { "type": "string", "description": "Student requesting the match" },
        "status": { "type": "string", "enum": ["pending", "declined", "cancelled", "accepted", "ended"] },
        "activityInterest": { "type": "string", "maxLength": 100 },
        "requesterName": { "type": "string", "maxLength": 100 },
        "requesterYear": { "type": "string", "maxLength": 50 },
        "activityId": { "type": "string", "description": "Linked 1-to-1 Squad Activity ID" },
        "createdAt": { "type": "string", "description": "Creation server timestamp" },
        "updatedAt": { "type": "string", "description": "Update server timestamp" }
      },
      "required": ["hostUid", "requesterUid", "status", "activityInterest", "requesterName"]
    },
    "ActivityFeedback": {
      "title": "ActivityFeedback",
      "description": "Rating and feedback submitted by a verified squad participant for another member",
      "type": "object",
      "properties": {
        "activityId": { "type": "string" },
        "activityTitle": { "type": "string" },
        "isOneToOne": { "type": "boolean" },
        "raterId": { "type": "string" },
        "raterName": { "type": "string" },
        "targetUserId": { "type": "string" },
        "targetUserName": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "tags": { "type": "array" },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["activityId", "raterId", "targetUserId", "rating"]
    },
    "UserReputation": {
      "title": "UserReputation",
      "description": "Public aggregate reputation stats for a student",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "averageRating": { "type": "number" },
        "totalRatings": { "type": "number" },
        "ratingSum": { "type": "number" },
        "starDistribution": { "type": "object" },
        "tagCounts": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "averageRating", "totalRatings"]
    },
    "UserModeration": {
      "title": "UserModeration",
      "description": "Private student moderation records including distinct 1-star raters and suspension states",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "distinctOneStarRaters": { "type": "array" },
        "distinctOneStarCount": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "suspensionStartedAt": { "type": "string" },
        "suspensionExpiresAt": { "type": "string" },
        "suspensionReason": { "type": "string" },
        "appealStatus": { "type": "string" },
        "appealReason": { "type": "string" },
        "appealedAt": { "type": "string" },
        "reviewedByAdmin": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewNote": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "isSuspended"]
    },
    "SuspensionRecord": {
      "title": "SuspensionRecord",
      "description": "Moderation suspension log created when 5 distinct 1-star ratings are received",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "reason": { "type": "string" },
        "startedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "triggeringRatingRefs": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "appealed", "expired", "resolved"] },
        "appealReason": { "type": "string" },
        "appealedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "reason", "startedAt", "expiresAt", "status"]
    },
    "ActivityReport": {
      "title": "ActivityReport",
      "description": "Persistent safety report submitted by a campus student against an activity",
      "type": "object",
      "properties": {
        "activityId": { "type": "string" },
        "activityTitle": { "type": "string", "maxLength": 150 },
        "reporterUid": { "type": "string" },
        "reason": { "type": "string", "enum": ["Inappropriate content", "Spam or commercial", "Non-public or private venue", "Harassment", "Other"] },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "reviewed", "dismissed"] },
        "reviewedByAdmin": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["activityId", "activityTitle", "reporterUid", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and campus identity keyed by authenticated UID"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Stores campus activities and sports squads created by students"
    },
    "/matchRequests/{requestId}": {
      "schema": "MatchRequest",
      "description": "Stores 1-to-1 peer match requests between campus students"
    },
    "/feedbackPrivate/{feedbackId}": {
      "schema": "ActivityFeedback",
      "description": "Stores private participant ratings and endorsements for completed activities"
    },
    "/userReputations/{userId}": {
      "schema": "UserReputation",
      "description": "Stores public reputation scores, average rating, star breakdown, and tag counts"
    },
    "/userModeration/{userId}": {
      "schema": "UserModeration",
      "description": "Stores private moderation data and temporary suspension states"
    },
    "/suspensions/{suspensionId}": {
      "schema": "SuspensionRecord",
      "description": "Stores moderation records for temporary 15-day student suspensions"
    },
    "/reports/{reportId}": {
      "schema": "ActivityReport",
      "description": "Stores persistent activity safety reports for administrator moderation review"
    }
  }
}
